name = "buildwithgemini-linkedin-post-agent"
main = "src/index.js"
compatibility_date = "2024-03-03"

# D1 Database Binding
# Note: Create your D1 database in the Cloudflare Dashboard:
# Workers & Pages -> D1 -> Create database -> Dashboard.
# Then update the database_id below with your unique DB ID.
[[d1_databases]]
binding = "DB"
database_name = "spb-analytics-db"
database_id = "YOUR_DATABASE_ID_HERE"
